# Copia este archivo a "keystore.properties" (mismo directorio) para firmar
# la APK de release en tu máquina. NO se commitea (está en .gitignore).
#
# 1. Genera el keystore una sola vez (guárdalo fuera del repo y respáldalo):
#    keytool -genkeypair -v -keystore timon-release.jks -alias timon \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Rellena estos valores. storeFile es la ruta al .jks (relativa a android/app o absoluta).

storeFile=timon-release.jks
storePassword=CAMBIA_ESTO
keyAlias=timon
keyPassword=CAMBIA_ESTO

# Para GitHub Actions NO se usa este archivo: se pasan como secrets
#   ANDROID_KEYSTORE_BASE64  = base64 -w0 timon-release.jks
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
