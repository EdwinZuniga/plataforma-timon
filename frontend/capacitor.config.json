{
  "appId": "org.renovacioncarismatica.timon",
  "appName": "Plataforma Timón",
  "webDir": "dist",
  "server": {
    "url": "https://plataforma-timon.vercel.app",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    }
  }
}
