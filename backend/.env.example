# ── BASE DE DATOS ──────────────────────────────────────────────────────────
# Autenticación de Windows (recomendado para desarrollo local)
DATABASE_URL="sqlserver://localhost:1433;database=plataforma_timon;integratedSecurity=true;trustServerCertificate=true"
# Autenticación SQL Server (producción)
# DATABASE_URL="sqlserver://localhost:1433;database=plataforma_timon;user=sa;password=TuPassword;trustServerCertificate=true"

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=reemplazar_con_cadena_aleatoria_larga_minimo_64_chars
JWT_REFRESH_SECRET=otra_cadena_aleatoria_diferente_minimo_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SERVIDOR ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── UPLOADS ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
